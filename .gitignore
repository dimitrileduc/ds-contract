# visual-parity artifacts: cached Figma PNGs + per-variant triptychs (the
# worst-10 triptychs are committed under extract/figma/visual-parity/report-assets/)
extract/figma/visual-parity/out/

# built at playground build time (scripts/build-plugin-zip.mjs)
playground/public/ds-contracts-sync-runner-plugin.zip

# organism-audit scratch: the Vite harness page + its dist bundle and capture
# PNGs (the committed artifacts are the audit's JSON receipts + report, 013)
extract/figma/organism-audit/out/

# live-gauntlet artifacts: cached Figma PNGs + rendered variants (bank once,
# replay offline; manifest is written alongside, also ignored)
extract/figma/gauntlet/live/out/
.gauntlet-live-cache/

# page-parity working PNGs: live before/after captures + calibration runs (the
# committed artifacts are verdicts + accepted-diff crops under specs/003-…/proofs/)
extract/figma/page-parity/out/
.page-parity/

# generic local image-parity reports and cropped diagnostics
.image-parity/

# state-photo artifacts: cached Figma PNGs + labeled snapshot manifests
# (committed: reports/ + report-assets/ — the before/after score proof, 002)
extract/figma/state-photo/out/

# positional-scan capture session (raw per-page chunks) — the assembled E5
# JSON the session writes explicitly is committed, this staging dir is not (002)
extract/figma/audit/out/

# computed-capture floor: transient render surfaces + per-pair screenshots
# (the committed artifacts are the JSON receipts + a few paired receipts)
extract/computed/out/.orig-shots/
extract/computed/out/**/gate-shots/
extract/computed/out/**/.replay-shots/
extract/computed/out/**/gate.html
extract/computed/out/**/replay.html
evals/.computed-replay.html
extract/computed/out/.regate-probe.html

# Pages de revue visuelle générées (016) : images embarquées en base64, ~8-12 Mo.
# L'OUTIL est versionné (specs/016-canvas-vrai/tools/revue-visuelle.mts), pas ses
# sorties — elles se regénèrent en une commande depuis les captures.
specs/*/proofs/REVUE-VISUELLE*.html

# Copies temporaires des scripts bridge spec-locaux dans le jail du receveur.
# `receiver.mjs` ne sert que son propre dossier ; les scripts de specs/*/bridge/ y
# sont copiés le temps d'une fenêtre de travail. La SOURCE versionnée reste
# specs/<spec>/bridge/ — ces copies ne doivent jamais devenir une seconde vérité.
extract/figma/page-parity/bridge/_0*-*.js
specs/018-odoo-replique-manuelle/instance/.docker-cfg/

# Bytecode Python. Le module Odoo de 018 est monté en écriture dans le conteneur
# (instance/compose.yaml), donc Odoo y écrit son __pycache__ à chaque installation.
# Un .pyc avait été committé une fois — le supprimer sans cette règle le ferait
# revenir au prochain montage.
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# spec 019 — env local de l'instance jetable de qualification (jamais commité)
integrations/odoo/qa/.env
# spec 023 — le MODÈLE d'env (aucun secret) doit être commité : la règle large
# `.env*` (ligne 17) l'attrapait, d'où son absence des worktrees frais. On le réinclut.
!integrations/odoo/qa/.env.example

# 029+: capture/scenario PNGs stay out of git — JSON receipts + sha256 manifests
# + pinned Figma versions are the durable evidence (owner decision 2026-08-27)
specs/component-repairs/*/run-*/**/*.png
specs/component-repairs/*/run-*/*.png
specs/029-figma-responsive-categories/proofs/**/*.png
