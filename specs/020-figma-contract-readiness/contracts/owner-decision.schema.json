{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ds-contracts.local/specs/020/owner-decision.schema.json",
  "title": "Owner Decision",
  "type": "object",
  "required": ["schemaVersion", "decisionId", "sectionId", "gate", "decision", "subjectId", "rationale", "decidedBy", "decidedAt", "reviewTiming", "acceptedConsequences", "receiptRefs"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "decisionId": { "type": "string", "minLength": 1 },
    "sectionId": {
      "enum": [
        "coordonnees", "devis", "equipe", "faq", "formulaire", "header",
        "hero", "footer", "reassurances", "sav", "texte-seo"
      ]
    },
    "gate": { "enum": ["reference", "post-repair"] },
    "decision": { "enum": ["reference-validated", "voluntary-evolution", "accepted-defect", "out-of-contract", "more-evidence-required", "no-reference-recoverable", "repair-accepted", "repair-refused"] },
    "subjectId": { "type": "string", "minLength": 1 },
    "rationale": { "type": "string", "minLength": 1 },
    "decidedBy": { "type": "string", "minLength": 1 },
    "decidedAt": { "type": "string", "format": "date-time" },
    "reviewTiming": {
      "type": "object",
      "required": ["startedAt", "completedAt", "activeSeconds", "excludedExplorationSeconds"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "activeSeconds": { "type": "integer", "minimum": 0 },
        "excludedExplorationSeconds": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "acceptedConsequences": { "type": "array", "items": { "type": "string" } },
    "receiptRefs": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
