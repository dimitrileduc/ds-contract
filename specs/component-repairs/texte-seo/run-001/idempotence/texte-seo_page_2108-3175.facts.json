  "textContent": [
    {
      "characters": "Plus de 50 ans d’expérience",
      "structuralPath": "0/0/0"
    },
    {
      "characters": "L'expert de la porte de garage Hörmann en Province de Liège",
      "structuralPath": "0/0/1"
    },
    {
      "characters": "Depuis plus de 50 ans, la société Piqueray accompagne les particuliers et les professionnels dans le choix de leurs fermetures. En tant que partenaire officiel Hörmann, nous vous garantissons des produits alliant innovation allemande et savoir-faire local. Que ce soit pour une rénovation résidentielle ou un complexe industriel, nos solutions sur mesure assurent isolation, sécurité et longévité à votre bâtiment. Nos équipes se déplacent de Verviers à Liège pour étudier votre projet.",
      "structuralPath": "1/0"
    },
    {
      "characters": "Tout savoir sur votre installation",
      "structuralPath": "2/0"
    },
    {
      "characters": "Budget et Devis sur mesure",
      "structuralPath": "3/0/1/0"
    },
    {
      "characters": "Garantie et Fiabilité Hörmann",
      "structuralPath": "3/1/0/0/0"
    },
    {
      "characters": "Les portes de garage Hörmann bénéficient généralement d'une garantie de 10 ans, et les moteurs de 5 ans, gage d'une qualité durable.",
      "structuralPath": "3/1/2"
    },
    {
      "characters": "Zone d'intervention Piqueray",
      "structuralPath": "3/2/1/0"
    }
  ],
