  "textContent": [
    {
      "characters": "Plus de 50 ans d’expérience",
      "structuralPath": "0/0/0"
    },
    {
      "characters": "Automatisez vos accès : confort, rapidité et sécurité Hörmann",
      "structuralPath": "0/0/1"
    },
    {
      "characters": "Fini de descendre de voiture sous la pluie. Piqueray vous propose les motorisations Hörmann de dernière génération (SupraMatic, ProMatic, RotaMatic). Au-delà du confort, c'est un gain de sécurité : le système de verrouillage mécanique breveté empêche le relevage forcé de la porte, même en cas de coupure de courant. De plus, grâce au système radio BiSecur, le signal de votre télécommande est crypté et inviolable.",
      "structuralPath": "1/0"
    },
    {
      "characters": "Compatibilité et fonctionnement",
      "structuralPath": "2/0"
    },
    {
      "characters": "Motorisation sur porte existante",
      "structuralPath": "3/0/1/0"
    },
    {
      "characters": "Maison connectée et smartphone",
      "structuralPath": "3/1/0/0/0"
    },
    {
      "characters": "Via la passerelle Hörmann BiSecur et l'application dédiée, contrôlez l'état de votre porte et actionnez-la à distance depuis votre smartphone.",
      "structuralPath": "3/1/2"
    },
    {
      "characters": "Sécurité en cas de coupure de courant",
      "structuralPath": "3/2/1/0"
    }
  ],
