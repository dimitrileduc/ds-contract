  "textContent": [
    {
      "characters": "Plus de 50 ans d’expérience",
      "structuralPath": "0/0/0"
    },
    {
      "characters": "Piqueray : une entreprise familiale au service de votre habitat",
      "structuralPath": "0/0/1"
    },
    {
      "characters": "Depuis sa création, la société Piqueray a su évoluer tout en restant fidèle à ses racines à Pepinster, au cœur de la Province de Liège. Notre force réside dans la stabilité de notre équipe et notre partenariat historique en tant que distributeur officiel Hörmann. Nous ne sommes pas de simples vendeurs : nous sommes des techniciens passionnés qui connaissent chaque boulon de vos futures installations. Choisir Piqueray, c'est choisir la proximité d'une PME locale alliée à la puissance d'une marque allemande de renommée mondiale.\r",
      "structuralPath": "1/0"
    },
    {
      "characters": "Nos engagements",
      "structuralPath": "2/0"
    },
    {
      "characters": "Formation continue des équipes",
      "structuralPath": "3/0/1/0"
    },
    {
      "characters": "Respect des délais et du chantier ",
      "structuralPath": "3/1/0/0/0"
    },
    {
      "characters": "Nous mettons un point d'honneur à respecter le planning annoncé et à laisser un chantier propre après chaque installation de porte de garage ou de porte d'entrée.",
      "structuralPath": "3/1/2"
    },
    {
      "characters": "Un service client à visage humain",
      "structuralPath": "3/2/1/0"
    }
  ],
