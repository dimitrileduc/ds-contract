  "textContent": [
    {
      "characters": "Plus de 50 ans d’expérience",
      "structuralPath": "0/0/0"
    },
    {
      "characters": "Un service après-vente réactif pour vos portes et motorisations",
      "structuralPath": "0/0/1"
    },
    {
      "characters": "Une porte de garage bloquée ou une motorisation en panne ne prévient pas. Basée à Pepinster, l'équipe technique de Piqueray intervient rapidement dans toute la province de Liège. Nous disposons d'un stock de pièces détachées d'origine Hörmann (ressorts, câbles, roulettes) pour assurer des réparations durables. Nous effectuons également les entretiens nécessaires pour garantir la longévité de vos installations.",
      "structuralPath": "1/0"
    },
    {
      "characters": "Assistance technique",
      "structuralPath": "2/0"
    },
    {
      "characters": "Marques prises en charge",
      "structuralPath": "3/0/1/0"
    },
    {
      "characters": "Préparer l'intervention (N° Série)",
      "structuralPath": "3/1/0/0/0"
    },
    {
      "characters": "Pour un dépannage efficace, munissez-vous du numéro de série de votre porte (indiqué sur l'étiquette signalétique à l'intérieur du panneau).",
      "structuralPath": "3/1/2"
    },
    {
      "characters": "Fréquence d'entretien recommandée",
      "structuralPath": "3/2/1/0"
    }
  ],
