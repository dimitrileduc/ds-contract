    {
      "characters": "FAQ",
      "structuralPath": "0/0"
    },
    {
      "characters": "Questions fréquentes",
      "structuralPath": "0/1"
    },
    {
      "characters": "Nos portes répondent-elles aux normes des bâtiments publics ?",
      "structuralPath": "1/0/1/0"
    },
    {
      "characters": "Quels types de bardages peuvent être intégrés sur les portes ?",
      "structuralPath": "1/1/0/0/0"
    },
    {
      "characters": "Nos portes sont conçues pour recevoir tout type de bardage, garantissant une intégration parfaite à votre façade. Nous travaillons notamment avec les bardages Renson, Trespa, Alubond, Bois ou Eternit.",
      "structuralPath": "1/1/2"
    },
    {
      "characters": "Assurez-vous la maintenance après l'installation ?",
      "structuralPath": "1/2/1/0"
    },
    {
      "characters": "Contactez-nous",
      "structuralPath": "2/1"
    }
  ],
