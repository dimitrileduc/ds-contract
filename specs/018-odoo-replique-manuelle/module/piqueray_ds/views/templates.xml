<?xml version="1.0" encoding="utf-8"?>
<!--
  Les TROIS modèles de la chaîne gouvernée, ÉCRITS À LA MAIN.

  L'imbrication est portée par le mécanisme d'appel entre modèles d'Odoo
  (`t-call`), JAMAIS par duplication de balisage (FR-002) : la chaîne se vérifie
  en lisant les appels, pas en comparant deux blocs de XML. Trois niveaux :

      s_presentation  ──t-call──▶  t_section_header  ──t-call──▶  t_button
                      └───────────────────t-call───────────────────▶  t_button

  Limite du moteur, connue et non supposée : `ir_qweb.py` `_render_iterall` lève
  `RecursionError` au-delà de 50 cadres de rendu. Nous en avons 3.

  UN SEUL de ces modèles est déclaré comme bloc posable (voir snippets.xml) :
  `s_presentation`. Les deux autres sont présents dans le module et absents du
  panneau (FR-003) — un patron courant de la source 19.0, pas une astuce
  (`s_masonry_block`, `s_dynamic_snippet_template`, `website_search_box_input`
  font exactement cela).

  CONVENTION D'APPEL, et elle est délibérée : chaque site d'appel passe TOUS les
  paramètres du modèle appelé, explicitement. Aucun modèle ne lit une variable
  qu'un appelant pourrait ne pas avoir posée — un nom absent du contexte QWeb est
  une erreur de rendu, pas un `None` silencieux. C'est aussi ce qu'un émetteur
  ferait : il connaît toutes les valeurs de la composition.
-->
<odoo>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ds.button v2.0.0 — NIVEAU 3 (et niveau 2 depuis la présentation)
       Tableau des zones : ../../zones/ds-button.json
       Modifiable : children (libellé), variant, iconLeft/iconRight, les 2 glyphes
       Figé       : toutes les parts en tant qu'éléments
       ═══════════════════════════════════════════════════════════════════════ -->
  <template id="t_button" name="Piqueray · Bouton">
    <!--
      `oe_unremovable oe_unmovable` : le levier L1, PAR ÉLÉMENT. La prémisse
      « un seul marqueur ferme tout le sous-arbre » est RÉFUTÉE (research.md
      §D11/P1) — seul `o_not_editable` porte sur le sous-arbre, ces deux-là sont
      par élément. Odoo compose exactement ces trois classes sur son propre
      `s_dynamic_snippet`. Ce balisage est entièrement MÉCANIQUE : il se dérive
      du tableau des zones — toute part que le tableau ne déclare pas modifiable
      les reçoit. Il gonfle le volume écrit sans gonfler la part de jugement,
      donc c'est un chiffre EN FAVEUR d'un émetteur.
    -->
    <button type="button" data-part="root"
            t-attf-class="button button--variant-#{variant} button--iconLeftGlyph-#{glyph_left} button--iconRightGlyph-#{glyph_right} oe_unremovable oe_unmovable">
      <span t-if="variant == 'iconOnly'" role="img" t-att-aria-label="libelle" data-part="iconOnlyIcon"
            t-attf-class="button__iconOnlyIcon pqr-glyph pqr-glyph--#{glyph_left} oe_unremovable oe_unmovable"/>
      <span t-if="variant != 'iconOnly' and icon_left" aria-hidden="true" data-part="iconLeft"
            t-attf-class="button__iconLeft pqr-glyph pqr-glyph--#{glyph_left} oe_unremovable oe_unmovable"/>
      <span class="button__label oe_unremovable oe_unmovable" data-part="label"><t t-esc="libelle"/></span>
      <span t-if="variant != 'iconOnly' and icon_right" aria-hidden="true" data-part="iconRight"
            t-attf-class="button__iconRight pqr-glyph pqr-glyph--#{glyph_right} oe_unremovable oe_unmovable"/>
    </button>
  </template>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ds.section-header v2.1.1 — NIVEAU 2
       Tableau des zones : ../../zones/ds-section-header.json
       AUCUNE zone modifiable — les six props sont fixées par la composition du
       parent. Ce composant n'aura donc aucun panneau de réglages, et c'est un
       résultat consigné, pas un oubli.
       ═══════════════════════════════════════════════════════════════════════ -->
  <template id="t_section_header" name="Piqueray · En-tête de section">
    <div data-part="root"
         t-attf-class="section-header section-header--disposition-#{disposition} section-header--emphase-#{emphase} section-header--alignement-#{alignement} oe_unremovable oe_unmovable">
      <!-- Part masquée sur le chemin emprunté (le parent compose avec
           accroche2 = False). Écrite avec sa condition parce que la surface de
           référence émet sa règle CSS pour toutes les parts, y compris masquées —
           et parce que c'est la source du littéral nommé `letter-spacing: 3px`. -->
      <span t-if="accroche2" class="section-header__Accroche oe_unremovable oe_unmovable" data-part="Accroche"><t t-esc="accroche"/></span>

      <!-- Le contrat porte `titre` en rich-text avec une marque `strong` liée à
           {font.weight.bold} : le gras reste donc gouverné. L'appelant fournit le
           balisage exact que la surface de référence produit. -->
      <span class="section-header__Titre oe_unremovable oe_unmovable" data-part="Titre"><t t-out="titre_html"/></span>

      <!-- LE TROISIÈME NIVEAU. L'appel existe et il est écrit ; il ne se rend que
           si `disposition == 'avecCta'`, ce que le bloc posé ne permet pas
           (zones/ds-section-header.json fige `disposition` à `standard`, décision
           d'owner du 2026-08-06). Il est exercé en fonctionnement sur une page de
           mesure — voir harness.xml. Les valeurs passées sont celles que la
           composition du contrat fixe : variant `outlineNoir`, libellé
           « Voir les produits ». -->
      <t t-if="disposition == 'avecCta'">
        <t t-call="piqueray_ds.t_button">
          <t t-set="variant" t-value="'outlineNoir'"/>
          <t t-set="libelle" t-value="'Voir les produits'"/>
          <t t-set="icon_left" t-value="False"/>
          <t t-set="icon_right" t-value="False"/>
          <t t-set="glyph_left" t-value="'arrow-left'"/>
          <t t-set="glyph_right" t-value="'arrow-right'"/>
        </t>
      </t>
    </div>
  </template>

  <!-- ═══════════════════════════════════════════════════════════════════════
       ds.presentation v2.5.0 — NIVEAU 1, LE SEUL BLOC POSABLE
       Tableau des zones : ../../zones/ds-presentation.json
       Modifiable : texte (contenu), bouton (présence du CTA)
       Figé       : titre (PROP ORPHELINE — défaut de source B013-1), structure
       ═══════════════════════════════════════════════════════════════════════ -->
  <template id="s_presentation" name="Piqueray · Présentation">
    <!--
      ⚠️ CE QUI A CHANGÉ, et il faut le lire avant le reste. À l'origine le
      conteneur intérieur était `<div class="container">` de Bootstrap, et il
      achetait l'éditabilité GRATUITEMENT : `section > .container` est l'un des
      sélecteurs par défaut de `content_editable_selectors`. Ce n'est PLUS le
      cas — le conteneur est maintenant `.pqr-page` (voir plus bas pourquoi), qui
      n'est dans aucun défaut d'Odoo. L'éditabilité des trois textes vient donc
      entièrement de `static/src/js/piqueray_option.js`, qui les rouvre nommément
      après avoir tout fermé. La réduction de coût que le balisage seul procurait
      n'existe plus : elle est devenue du JavaScript, et ça compte au chiffrage.

      LA RACINE RESTE UNE <section>, et c'est un choix mesuré. Les options
      natives qui polluaient le bloc (Background, Content Width, Visibility,
      Layout/Spacing, Scroll Button) se branchent toutes sur cette balise. Deux
      voies existaient : changer de balise, ou retirer notre sélecteur de ces
      options. La seconde a gagné parce qu'elle est CHIRURGICALE — elle nomme
      les options écartées une par une, ne touche rien d'autre sur le site, et
      garde l'éditabilité automatique. Voir static/src/js/piqueray_option.js.

      ⚠️ FAIT CONTRE-INTUITIF, constaté en fonctionnement puis expliqué par le
      code : `o_not_editable` NE FERME PAS l'édition de texte à l'intérieur d'un
      snippet. `builder_content_editable_plugin.js` le dit en clair — un élément
      sous `.o_not_editable` reste éditable dès lors que ce `.o_not_editable` est
      lui-même sous un `[data-snippet]`. C'est voulu : les sous-parties d'un bloc
      doivent rester modifiables. Conséquence pour nous : geler un texte passe
      OBLIGATOIREMENT par `content_not_editable_selectors`, jamais par le
      balisage seul.

      `data-snippet` et `data-name` sont posés explicitement : la doc les exige
      pour un bloc déclaré, et toute la mécanique d'éditabilité ci-dessus en
      dépend.

      Fait favorable, à ne pas sur-payer : rien n'est zone de dépôt par défaut.
      `dropzone_selector` est une LISTE BLANCHE — un conteneur qui ne s'enregistre
      pas et n'imite pas les sélecteurs génériques d'Odoo (`.oe_structure`,
      `.row > div`) n'accepte aucun dépôt. Ne rien faire est ici la bonne action.
    -->
    <section class="s_piqueray_presentation" data-snippet="s_piqueray_presentation"
             data-name="Piqueray · Présentation">
      <!--
        LE CONTENEUR DE PAGE. Il n'appartient à aucun contrat, et c'est voulu :
        « quelle largeur fait une page » est une décision de site, pas de
        composant. Le contrat de la Présentation ne porte donc aucune largeur —
        il centre son contenu dans ce qu'on lui donne.

        Reçu de l'erreur qui a rendu cette ligne nécessaire (2026-08-07) : un
        `<div class="container">` de Bootstrap jouait ce rôle sur le bloc posé
        d'origine. Il a été retiré parce que sa gouttière de 15 px coûtait
        4,17 % dans la comparaison d'image. La mesure est passée à 0,0000 % et
        la vraie page a cassé : sans borne, `<section>` prend la largeur de
        l'écran et les colonnes du composant s'écartent. L'instrument a
        récompensé la suppression de ce qui faisait marcher la page.

        Donc : on remet la borne, mais la nôtre, sans la gouttière. La page de
        mesure (`.pqr-mesure`, en `position:absolute`) se rétracte sur son
        contenu et n'est pas affectée — raison de plus pour laquelle elle ne
        voyait rien.
      -->
      <div class="pqr-page">
        <div class="presentation" data-part="root">

          <!-- Colonne gauche — structure figée, rien d'éditable à l'intérieur.
               `o_not_editable` y ferme les réglages ET l'usage comme zone de
               dépôt sur tout le sous-arbre (L1, portée sous-arbre). -->
          <div class="presentation__colGauche o_not_editable oe_unremovable oe_unmovable" data-part="colGauche">
            <t t-call="piqueray_ds.t_section_header">
              <!-- Les valeurs que la composition du contrat fixe, à l'identique.
                   `disposition: standard` est écrit EN DUR par ds.presentation —
                   le contrat n'emploie pas le report de prop du parent, pourtant
                   offert par le schéma (ComponentRefSchema). Le répliquer
                   fidèlement, c'est écrire cette valeur ici. -->
              <t t-set="disposition" t-value="'standard'"/>
              <t t-set="emphase" t-value="'moyen'"/>
              <t t-set="alignement" t-value="'gauche'"/>
              <t t-set="accroche2" t-value="False"/>
              <t t-set="accroche" t-value="'Plus de 50 ans d’expérience'"/>
              <t t-set="titre_html"><strong>Piqueray, </strong><span>une histoire de famille </span></t>
            </t>
          </div>

          <!-- Colonne droite — le texte y est éditable, donc PAS de
               `o_not_editable` sur ce conteneur : il le fermerait aussi. -->
          <div class="presentation__wrapper oe_unremovable oe_unmovable" data-part="wrapper">
            <span class="presentation__Texte oe_unremovable oe_unmovable" data-part="Texte"><strong>Depuis plus de 50 ans,</strong><span> la société Piqueray est une référence en Province de Liège. Aujourd'hui dirigée par Florian et Cécilia Piqueray, l'entreprise perpétue les valeurs de </span><strong>proximité et d'excellence technique</strong><span>. Dépositaire officiel </span><strong>Hörmann</strong><span>, nous allions la force d'un leader mondial à </span><strong>la souplesse d'une PME locale</strong><span>.</span></span>

            <!-- Le bouton de NIVEAU 2, conditionné par la prop `bouton`
                 (modifiable, défaut `true` au contrat depuis ds.presentation
                 v2.5.0). C'est le seul appel de la chaîne qui se rend sur le
                 bloc posé.

                 La prop `bouton` d'un snippet posé n'est pas une variable QWeb :
                 une fois le bloc déposé, son HTML est stocké dans la page. Le
                 réglage « afficher le bouton » agit donc sur le DOM (voir
                 static/src/js/), et le gabarit doit livrer le bouton PRÉSENT dans
                 l'état que le contrat déclare par défaut — visible, donc avec
                 `pqr-cta-on`. C'est une contrainte du modèle d'Odoo, pas un
                 choix : elle est comptée en cas particulier.

                 ⚠️ DIVERGENCE ASSUMÉE, ET ELLE EST À NOUS. La surface de
                 référence (`emit-html`) pose le `<button>` DIRECTEMENT dans
                 `wrapper` — ce `<div class="presentation__cta">` n'existe nulle
                 part dans le contrat. Il est là uniquement pour donner au réglage
                 Odoo un point d'accroche stable (`applyTo`) sans que la règle
                 `display` du bouton, elle, soit réécrite à la main. Le coût en
                 pixels est MESURÉ, pas supposé : voir proofs/comparaison-image.json.

                 Les trois valeurs ci-dessous ne sont pas libres : elles sont la
                 composition que le contrat fixe (`variant: link`, `iconRight:
                 true`) et le défaut de ds.button pour le libellé. -->
            <div class="presentation__cta pqr-cta-on oe_unremovable oe_unmovable" data-part="Bouton">
              <t t-call="piqueray_ds.t_button">
                <t t-set="variant" t-value="'link'"/>
                <t t-set="libelle" t-value="'Contactez-nous'"/>
                <t t-set="icon_left" t-value="False"/>
                <t t-set="icon_right" t-value="True"/>
                <t t-set="glyph_left" t-value="'arrow-left'"/>
                <t t-set="glyph_right" t-value="'arrow-right'"/>
              </t>
            </div>
          </div>

        </div>
      </div>
    </section>
  </template>

</odoo>
