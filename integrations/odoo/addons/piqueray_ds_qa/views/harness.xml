<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    ODOO-019-HARNESS — le banc d'essai. Spec 019, tâche T017.

    Ce fichier ne fait PAS partie du produit livré au client : il sert aux
    scénarios de qualification. Il est déclaré dans `data` du manifeste parce
    qu'un banc qu'il faut installer à la main n'est jamais rejoué.

    ── Ce que la page d'éditabilité met à l'épreuve ─────────────────────────
    Une racine FERMÉE portant `data-snippet` (donc traitée comme un snippet par
    `isDescendantOfNotEditableNotSnippet` du noyau), avec :
      · DEUX textes rouverts nommément (`.o_pqr_editable`) ;
      · QUATRE descendants qui doivent rester verrouillés — un texte de colonne
        figée, un titre d'en-tête, un libellé de bouton, un bloc structurel.

    Volontairement AUCUN `.container` sous la `<section>` : le noyau ouvre
    `section > .container` et fausserait le test en ouvrant tout. L'état final de
    018 a corrigé ce montage et prouvé la fermeture/réouverture sur un bloc ; ce
    banc la reproduit dans l'addon de production et ajoute les gestes structurels.
  -->

  <!-- ODOO-019-HARNESS-EDITABILITY BEGIN -->
  <template id="harness_editability_boundary" name="Piqueray — banc d'éditabilité">
    <t t-call="website.layout">
      <div id="wrap" class="oe_structure">
        <section class="s_pqr_presentation pqr-mesure" data-snippet="s_pqr_presentation"
                 data-ds-contract="ds.presentation"
                 data-pqr-root-actions="move duplicate remove"
                 style="padding: var(--pqr-space-24); background: var(--pqr-color-blanc);">

          <!--
            Le premier run A/B a tranché : `isValidContentEditable()` exige
            `closest(".o_editable")`. La zone 1 omet encore volontairement cette
            classe dans le HTML sauvegardé : le normalizer Piqueray doit la
            matérialiser avant celui du noyau. La zone 2 prouve que le mécanisme
            reste idempotent quand un futur QWeb l'émet déjà.
          -->
          <p class="o_pqr_editable pqr-zone-ouverte-1" data-pqr-part="presentation-text" data-pqr-marks="strong"
             data-pqr-role="rouverte">Zone rouverte numéro un — classe native matérialisée par politique.</p>
          <p class="o_pqr_editable o_editable pqr-zone-ouverte-2" data-pqr-part="presentation-text" data-pqr-marks=""
             data-pqr-role="rouverte">Zone rouverte numéro deux — classe native déjà émise.</p>

          <!-- Les QUATRE descendants qui doivent rester verrouillés. -->
          <div class="pqr-col-figee" data-pqr-role="verrouille">
            <p class="pqr-texte-fige">Colonne figée — la frappe doit être refusée ici.</p>
          </div>
          <h2 class="pqr-titre-fige" data-pqr-role="verrouille">Titre d'en-tête figé</h2>
          <a href="#" class="pqr-bouton-fige" data-pqr-role="verrouille">
            <span class="pqr-libelle-fige">Libellé de bouton figé</span>
          </a>
          <div class="pqr-bloc-structurel" data-pqr-role="verrouille">
            <span>Bloc structurel — ni déplaçable, ni duplicable, ni supprimable.</span>
          </div>
        </section>

        <!--
          Seconde INSTANCE, et non mutation artificielle de la première : Odoo
          calcule les raisons d'indisponibilité de Clone/Remove à la création du
          conteneur d'options. En production, `data-pqr-root-actions` est émis
          avec chaque bloc ; il n'est pas une préférence changée à chaud. Ces
          deux instances concurrentes prouvent donc la vraie frontière : les
          mêmes classes et le même plugin, avec deux verdicts indépendants.
        -->
        <section class="s_pqr_presentation pqr-actions-interdites"
                 data-snippet="s_pqr_presentation"
                 data-ds-contract="ds.presentation"
                 data-pqr-root-actions=""
                 style="padding: var(--pqr-space-24); background: var(--pqr-color-blanc);">
          <p class="pqr-actions-interdites__temoin" data-pqr-role="verrouille">
            Instance témoin — aucune action structurelle de racine autorisée.
          </p>
        </section>
      </div>
    </t>
  </template>

  <record id="page_harness_editability_boundary" model="website.page">
    <field name="url">/piqueray-harness/editability-boundary</field>
    <field name="view_id" ref="harness_editability_boundary"/>
    <field name="is_published" eval="True"/>
    <field name="website_indexed" eval="False"/>
  </record>
  <!-- ODOO-019-HARNESS-EDITABILITY END -->

