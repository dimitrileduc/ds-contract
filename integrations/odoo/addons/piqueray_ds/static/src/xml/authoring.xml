    <BuilderRow label.translate="Alternative">
      <span data-pqr-control="hero-video-background-alt"><BuilderTextInput action="'pqrSetHeroVideoPosterAlt'"/></span>
    </BuilderRow>
    <BuilderRow label.translate="Lien du CTA">
      <!-- BuilderUrlPicker : même grammaire/porte que le CTA Hero (repli même
           origine, javascript: refusé). Pas de wrapper `hero-cta` ici (l'anatomie
           ds.hero-video pose le Bouton en frère direct du root) : l'ancre PORTE
           son data-pqr-part, d'où l'action générique `pqrSetLinkHref`. -->
      <span data-pqr-control="hero-video-cta-href"><BuilderUrlPicker action="'pqrSetLinkHref'" actionParam="'button-root'"/></span>
    </BuilderRow>
  </t>
  <!-- ODOO-025-HERO-VIDEO-PANEL END -->

