  <template id="pqr_arrow_right"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.16675 10H15.8334M15.8334 10L10.8334 5M15.8334 10L10.8334 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></template>

  <template id="pqr_button" name="Piqueray · Button">
    <button type="button" t-attf-class="button button--variant-#{variant} button--iconLeftGlyph-#{glyph_left} button--iconRightGlyph-#{glyph_right} oe_unremovable oe_unmovable" data-pqr-part="button-root">
      <span t-if="variant == 'iconOnly'" class="button__iconOnlyIcon" data-pqr-part="button-icon-only"><t t-call="piqueray_ds.pqr_arrow_right"/></span>
      <span t-if="variant != 'iconOnly' and icon_left" class="button__iconLeft" data-pqr-part="button-icon-left"><t t-call="piqueray_ds.pqr_arrow_right"/></span>
      <span class="button__label o_pqr_editable" data-pqr-part="button-label" data-pqr-marks=""><t t-esc="label"/></span>
      <span t-if="variant != 'iconOnly' and icon_right" class="button__iconRight" data-pqr-part="button-icon-right"><t t-call="piqueray_ds.pqr_arrow_right"/></span>
    </button>
  </template>

  <template id="pqr_section_header" name="Piqueray · SectionHeader">
    <div t-attf-class="section-header section-header--disposition-#{disposition} section-header--emphase-#{emphase} section-header--alignement-#{alignement} oe_unremovable oe_unmovable" data-pqr-part="section-header-root">
      <span t-if="show_eyebrow" class="section-header__Accroche" data-pqr-part="section-header-eyebrow"><t t-esc="eyebrow"/></span>
      <span class="section-header__Titre o_pqr_editable" t-att-data-pqr-part="title_part" data-pqr-marks="strong"><t t-out="title_html"/></span>
      <t t-if="disposition == 'avecCta'">
        <t t-call="piqueray_ds.pqr_button"><t t-set="variant" t-value="'outlineNoir'"/><t t-set="label" t-value="'Voir les produits'"/><t t-set="icon_left" t-value="False"/><t t-set="icon_right" t-value="False"/><t t-set="glyph_left" t-value="'arrow-left'"/><t t-set="glyph_right" t-value="'arrow-right'"/></t>
      </t>
    </div>
  </template>

  <template id="s_pqr_presentation" name="Piqueray · Présentation">
    <section class="s_pqr_presentation presentation pqr-cta-on" data-snippet="s_pqr_presentation" data-name="Piqueray · Présentation"
             data-ds-contract="ds.presentation" data-ds-contract-version="2.5.0" data-ds-authoring-version="1.0.0"
             data-ds-graph-digest="cac34666a20a13d86d285e8d600e9fbf8da86b56e08404afba6ee5949c2fff1b"
             data-vcss="19.0.1.1.0" data-vxml="19.0.1.1.0" data-vjs="19.0.1.1.0"
             data-pqr-root-actions="move duplicate remove" data-pqr-instance="presentation-default" data-pqr-part="root">
      <div class="presentation__colGauche" data-pqr-part="left-column">
        <t t-call="piqueray_ds.pqr_section_header"><t t-set="disposition" t-value="'standard'"/><t t-set="emphase" t-value="'moyen'"/><t t-set="alignement" t-value="'gauche'"/><t t-set="show_eyebrow" t-value="False"/><t t-set="eyebrow" t-value="'Plus de 50 ans d’expérience'"/><t t-set="title_part" t-value="'presentation-title'"/><t t-set="title_html"><strong>Piqueray, </strong><span>une histoire de famille </span></t></t>
      </div>
      <div class="presentation__wrapper" data-pqr-part="content-wrapper">
        <span class="presentation__Texte o_pqr_editable" data-pqr-part="presentation-text" data-pqr-marks="strong"><strong>Depuis plus de 50 ans,</strong><span> la société Piqueray est une référence en Province de Liège. Aujourd'hui dirigée par Florian et Cécilia Piqueray, l'entreprise perpétue les valeurs de </span><strong>proximité et d'excellence technique</strong><span>. Dépositaire officiel </span><strong>Hörmann</strong><span>, nous allions la force d'un leader mondial à </span><strong>la souplesse d'une PME locale</strong><span>.</span></span>
        <div class="presentation__cta" data-pqr-part="presentation-cta">
          <t t-call="piqueray_ds.pqr_button"><t t-set="variant" t-value="'link'"/><t t-set="label" t-value="'Contactez-nous'"/><t t-set="icon_left" t-value="False"/><t t-set="icon_right" t-value="True"/><t t-set="glyph_left" t-value="'arrow-left'"/><t t-set="glyph_right" t-value="'arrow-right'"/></t>
        </div>
      </div>
    </section>
  </template>
