             data-pqr-root-actions="move duplicate remove" data-pqr-instance="google-reviews-default" data-pqr-part="root">
      <div class="google-reviews__resume" data-pqr-part="resume">
        <div class="google-reviews__infos" data-pqr-part="infos">
          <span class="google-reviews__marque" data-pqr-part="marque"><t t-call="piqueray_ds.pqr_google_wordmark"/></span>
          <span class="google-reviews__qualificatifTexte o_pqr_editable" data-pqr-part="qualificatif" data-pqr-marks="">Excellent</span>
          <div class="google-reviews__notation" data-pqr-part="notation"><span class="google-reviews__etoile1" data-pqr-part="etoile-1"><t t-call="piqueray_ds.pqr_star"/></span><span class="google-reviews__etoile2" data-pqr-part="etoile-2"><t t-call="piqueray_ds.pqr_star"/></span><span class="google-reviews__etoile3" data-pqr-part="etoile-3"><t t-call="piqueray_ds.pqr_star"/></span><span class="google-reviews__etoile4" data-pqr-part="etoile-4"><t t-call="piqueray_ds.pqr_star"/></span><span class="google-reviews__etoile5" data-pqr-part="etoile-5"><t t-call="piqueray_ds.pqr_star"/></span><span class="google-reviews__noteGlobaleTexte o_pqr_editable" data-pqr-part="note-globale" data-pqr-marks="">4.8</span></div>
          <span class="google-reviews__separateur" data-pqr-part="separateur">|</span>
          <span class="google-reviews__volume o_pqr_editable" data-pqr-part="volume" data-pqr-marks="">93 avis</span>
        </div>
        <div class="google-reviews__ecrireAvis" data-pqr-part="ecrire-avis"><span class="google-reviews__libelle" data-pqr-part="ecrire-avis-libelle">Écrire un avis</span></div>
      </div>
      <div class="google-reviews__cartes" data-pqr-part="cartes">
        <div class="google-reviews__flecheGauche" data-pqr-part="fleche-gauche" data-pqr-controls=""><div class="google-reviews__pastilleGauche" data-pqr-part="pastille-gauche"><span class="google-reviews__iconeGauche" data-pqr-part="icone-gauche"><t t-call="piqueray_ds.pqr_chevron_left"/></span></div></div>
        <div class="google-reviews__groupeCartes" data-pqr-review-list="" data-pqr-part="groupe-cartes">
          <t t-foreach="reviews" t-as="review"><t t-call="piqueray_ds.review_card"><t t-set="review" t-value="review"/><t t-set="review_index" t-value="review_index"/></t></t>
        </div>
        <div class="google-reviews__flecheDroite" data-pqr-part="fleche-droite" data-pqr-controls=""><div class="google-reviews__pastilleDroite" data-pqr-part="pastille-droite"><span class="google-reviews__iconeDroite" data-pqr-part="icone-droite"><t t-call="piqueray_ds.pqr_chevron_right"/></span></div></div>
      </div>
      <template data-pqr-review-blueprint=""><t t-call="piqueray_ds.review_card"><t t-set="review" t-value="{'auteur': 'Nouvel avis', 'initiale': 'N', 'date': 'à l’instant', 'texte': 'Nouveau témoignage.', 'tronque': False, 'initialeVisible': True, 'photo': False, 'photoUrl': '', 'photoAlt': '', 'verifie': True}"/><t t-set="review_index" t-value="'blueprint'"/></t></template>
    </section>
  </template>
