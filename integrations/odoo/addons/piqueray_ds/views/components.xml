  <!-- Un CTA qui NAVIGUE se projette en ancre (patron des snippets natifs —
       s_call_to_action & co : toujours <a class="btn">). La raison est
       SÉMANTIQUE, pas mécanique : un <button> qui navigue casse le clic
       milieu, le ctrl-clic, « ouvrir dans un nouvel onglet » et s'annonce
       « bouton » au lecteur d'écran alors que la page change.

       Ce n'est PAS le correctif du vol de focus en édition : celui-là a été
       mesuré le 2026-08-18 sur <button> PUIS sur <a href> — il est corrigé
       par la parade `pointer-events` du pont (ODOO-019-CTA-LIEN-BRIDGE), qui
       aurait aussi bien tenu sur <button>. Ne pas relire l'ancre comme la
       cause de cette réparation.

       ADAPTATION ODOO, jamais une prop de contrat : les contrats ne portent
       aucune notion de lien et `ds.button` reste un <button> sur la surface
       React (décision owner du 2026-08-18). `link_href` fourni → hôte <a> ;
       absent → hôte <button> inchangé pour les usages mécaniques. Le rendu
       est identique : .button est 100 % par classes, seul le soulignement UA
       des ancres est neutralisé au pont. -->
  <template id="pqr_button_interieur" name="Piqueray · Button (intérieur)">
    <span t-if="variant == 'iconOnly'" class="button__iconOnlyIcon" data-pqr-part="button-icon-only"><t t-call="piqueray_ds.pqr_arrow_right"/></span>
    <span t-if="variant != 'iconOnly' and icon_left" class="button__iconLeft" data-pqr-part="button-icon-left"><t t-call="piqueray_ds.pqr_arrow_right"/></span>
    <span class="button__label o_pqr_editable" data-pqr-part="button-label" data-pqr-marks=""><t t-esc="label"/></span>
    <span t-if="variant != 'iconOnly' and icon_right" class="button__iconRight" data-pqr-part="button-icon-right"><t t-call="piqueray_ds.pqr_arrow_right"/></span>
  </template>
  <template id="pqr_button" name="Piqueray · Button">
    <!-- La liste de classes EST tout le contrat visuel du bouton (variante +
         les deux modificateurs de glyphe). Elle se pose une fois : deux copies
         feraient qu'une variante ajoutée d'un seul côté rendrait non stylée sur
         l'autre, et la divergence resterait invisible jusqu'à ce qu'une section
         pose `link_href`. Seule la BALISE distingue les deux branches. -->
    <t t-set="button_class" t-value="'button button--variant-%s button--iconLeftGlyph-%s button--iconRightGlyph-%s oe_unremovable oe_unmovable' % (variant, glyph_left, glyph_right)"/>
    <a t-if="link_href" t-att-href="link_href" t-att-class="button_class" data-pqr-part="button-root"><t t-call="piqueray_ds.pqr_button_interieur"/></a>
    <button t-else="" type="button" t-att-class="button_class" data-pqr-part="button-root"><t t-call="piqueray_ds.pqr_button_interieur"/></button>
  </template>

