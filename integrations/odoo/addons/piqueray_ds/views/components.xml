  <!-- ds.notation — les CINQ bandes sont rendues, quatre masquées. Rendre la
       seule bande utile figerait la note : un bloc Odoo posé est une copie HTML
       gelée, et le panneau ne peut que masquer/démasquer ce qui existe déjà.
       Même leçon que « Lire la suite » et que la pastille photo. -->
  <template id="pqr_notation">
    <div class="notation" data-pqr-part="root">
      <t t-foreach="[1, 2, 3, 4, 5]" t-as="n">
        <div t-attf-class="notation__note#{n}" t-attf-data-pqr-part="note#{n}" t-att-hidden="None if str(n) == str(note) else 'hidden'">
          <t t-foreach="[1, 2, 3, 4, 5]" t-as="i">
            <span t-attf-class="notation__note#{n}Etoile#{i}" t-attf-data-pqr-part="note#{n}Etoile#{i}">
              <t t-if="i &lt;= n"><t t-call="piqueray_ds.pqr_star"/></t>
              <t t-else=""><t t-call="piqueray_ds.pqr_star_empty"/></t>
            </span>
          </t>
        </div>
      </t>
    </div>
  </template>
