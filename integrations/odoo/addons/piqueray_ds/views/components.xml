  <!-- Composant interne : pas de <section>, pas d'inscription snippet. -->
  <template id="review_card" name="Piqueray · ReviewCard">
    <article class="review-card oe_unremovable oe_unmovable"
             data-pqr-review-card=""
             data-pqr-part="root"
             t-attf-data-pqr-review-marker="review-#{review_index}"
             t-att-data-initiale-visible="'true' if review.get('initialeVisible', True) else 'false'"
             t-att-data-photo="'true' if review.get('photo', False) else 'false'"
             t-att-data-tronque="'true' if review.get('tronque', False) else 'false'"
             t-att-data-verifie="'true' if review.get('verifie', True) else 'false'">
      <div class="review-card__entete" data-pqr-part="entete">
        <div class="review-card__profil" data-pqr-part="profil">
          <div t-if="review.get('initialeVisible', True)" class="review-card__avatarInitiale" data-pqr-part="avatar-initiale">
            <span class="review-card__initialeTexte o_pqr_editable" data-pqr-part="initiale" data-pqr-marks=""><t t-esc="review.get('initiale', 'P')"/></span>
          </div>
          <div t-if="review.get('photo') and review.get('photoUrl') and review.get('photoAlt')" class="review-card__avatarPhoto" data-pqr-part="avatar-photo">
            <img class="o_editable_media" t-att-src="review.get('photoUrl')" t-att-alt="review.get('photoAlt')"/>
          </div>
          <div class="review-card__identite" data-pqr-part="identite">
            <span class="review-card__auteur o_pqr_editable" data-pqr-part="auteur" data-pqr-marks=""><t t-esc="review.get('auteur', 'Prénom N.')"/></span>
            <span class="review-card__date o_pqr_editable" data-pqr-part="date" data-pqr-marks=""><t t-esc="review.get('date', 'il y a 2 mois')"/></span>
          </div>
        </div>
        <span class="review-card__marque" aria-hidden="true" data-pqr-part="marque"><t t-call="piqueray_ds.pqr_google_mark"/></span>
      </div>
      <div class="review-card__notation" data-pqr-part="notation">
        <div class="review-card__etoiles" data-pqr-part="etoiles">
          <span class="review-card__etoile1" data-pqr-part="etoile-1"><t t-call="piqueray_ds.pqr_star"/></span><span class="review-card__etoile2" data-pqr-part="etoile-2"><t t-call="piqueray_ds.pqr_star"/></span><span class="review-card__etoile3" data-pqr-part="etoile-3"><t t-call="piqueray_ds.pqr_star"/></span><span class="review-card__etoile4" data-pqr-part="etoile-4"><t t-call="piqueray_ds.pqr_star"/></span><span class="review-card__etoile5" data-pqr-part="etoile-5"><t t-call="piqueray_ds.pqr_star"/></span>
        </div>
        <div t-if="review.get('verifie', True)" class="review-card__verification" data-pqr-part="verification"><span class="review-card__coche" data-pqr-part="coche"><t t-call="piqueray_ds.pqr_check"/></span></div>
      </div>
      <p class="review-card__temoignage o_pqr_editable" data-pqr-part="temoignage" data-pqr-marks="strong"><t t-esc="review.get('texte', 'Un témoignage neutre, exemple générique de contenu.')"/></p>
      <span t-if="review.get('tronque')" class="review-card__lireLaSuite" data-pqr-part="lire-la-suite">Lire la suite</span>
    </article>
  </template>

  <!-- Unique racine Google Reviews. La liste est du DOM sauvegardé : aucune
       source JSON parallèle ne survit au premier save Odoo. -->
