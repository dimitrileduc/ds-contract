<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- ODOO-019-GOOGLE-REVIEWS-SNIPPET BEGIN -->
  <template id="snippets_piqueray_google_reviews" inherit_id="website.snippets" name="Piqueray · Google Reviews dans la bibliothèque">
    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
      <t t-snippet="piqueray_ds.s_pqr_google_reviews" string="Piqueray · Google Reviews"
         t-thumbnail="/website/static/src/img/snippets_thumbs/s_rating.svg" group="content"/>
    </xpath>
  </template>
  <!-- ODOO-019-GOOGLE-REVIEWS-SNIPPET END -->
  <!-- ODOO-019-PRESENTATION-SNIPPET BEGIN -->
  <template id="snippets_piqueray_presentation" inherit_id="website.snippets" name="Piqueray · Présentation dans la bibliothèque">
    <xpath expr="//snippets[@id='snippet_structure']" position="inside">
      <t t-snippet="piqueray_ds.s_pqr_presentation" string="Piqueray · Présentation"
         t-thumbnail="/website/static/src/img/snippets_thumbs/s_text_image.svg" group="content"/>
    </xpath>
  </template>
  <!-- ODOO-019-PRESENTATION-SNIPPET END -->
</odoo>
