          </div>
        </div>
      </div>
  </template>

  <!-- Le header SYSTÈME : hérite website.layout, remplace la zone nav native par
       NOTRE barre. Naît INACTIF — la finalisation (hooks.py / migration) l'active
       et désactive le header par défaut d'Odoo (spike S1). -->
  <template id="template_header_piqueray" inherit_id="website.layout" name="Piqueray · Header (shell)" active="False">
    <xpath expr="//header//nav" position="replace">
      <t t-call="piqueray_ds.header_bar"/>
    </xpath>
  </template>

  <!-- Odoo 19 appelle `standard` un effet qui affixe tout de même le header après
       ~300 px (`HeaderStandard.onScroll`). Le produit demande un header de document
       normal : overlay au sommet de la Home, puis hors écran avec le scroll. Aucun
       autre effet de visibilité n'est activé. -->
  <record id="website.header_visibility_standard" model="ir.ui.view">
    <field name="active" eval="False"/>
  </record>
  <!-- ODOO-022-HEADER-QWEB END -->
</odoo>
