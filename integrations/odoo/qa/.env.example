# Instance Odoo jetable de qualification — valeurs d'EXEMPLE, jamais des secrets.
#
# Il n'y a pas de production ici : la base est détruite et recréée à chaque cycle
# (`installerAddon`, run.mts). Copier ce fichier en `.env` pour surcharger, ou
# exporter les variables dans le shell — les variables de PROCESSUS priment
# (même précédence que docker compose : shell > --env-file).
#
# Plusieurs vagues de qualification en parallèle s'isolent par COMPOSE_PROJECT_NAME
# + PQR_ODOO_PORT propres, jamais en se disputant ce fichier.

# — Images épinglées. Doivent concorder avec `integrations/odoo/config/inputs.lock.json`
#   (`npm run odoo:module:check` échoue sinon).
PQR_ODOO_IMAGE=odoo:19.0-20260803
PQR_POSTGRES_IMAGE=postgres:15

# — Ports publiés sur l'hôte
PQR_ODOO_PORT=8069
PQR_ODOO_GEVENT_PORT=8072

# — Base jetable
PQR_DB_NAME=piqueray_qa
PQR_DB_USER=odoo
PQR_DB_PASSWORD=odoo

# — Rédacteur website (jamais administrateur) : le rôle sous lequel les
#   scénarios mesurent l'édition. L'admin (admin/admin) ne sert qu'à provisionner.
PQR_EDITOR_LOGIN=editor@example.test
PQR_EDITOR_PASSWORD=editor
