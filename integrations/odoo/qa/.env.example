# integrations/odoo/qa/.env.example — modèle d'environnement de l'instance QA jetable.
#
# ZONE MANUELLE, AUCUN SECRET. Copier en `.env` (gitignoré) et ajuster si besoin :
#   cp integrations/odoo/qa/.env.example integrations/odoo/qa/.env
#
# Les deux images sont ÉPINGLÉES — miroir exact de inputs.lock.json (odoo.image /
# odoo.postgresImage) et de compose.yaml. La porte de structure du module
# (`npm run odoo:module:check`, testImages) vérifie que ces deux images figurent
# ici et concordent avec le lock.
#
# NB : ce fichier a longtemps été absent des worktrees frais — la règle large
# `.env*` du .gitignore l'attrapait alors qu'il ne porte aucun secret. La négation
# `!integrations/odoo/qa/.env.example` le réinclut désormais (spec 023).
PQR_ODOO_IMAGE=odoo:19.0-20260803
PQR_POSTGRES_IMAGE=postgres:15
PQR_DB_USER=odoo
PQR_DB_PASSWORD=odoo
PQR_ODOO_PORT=8069
PQR_ODOO_GEVENT_PORT=8072
